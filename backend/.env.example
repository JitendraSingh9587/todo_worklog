PORT=3334
HOST=0.0.0.0
# Docker Compose maps host 3333 → this PORT (see docker-compose.yml).
NODE_ENV=development
LOG_LEVEL=info

# Calendar JSON: ./backend/data (mounted in Docker).
# CALENDAR_DATA_DIR=/app/backend/data

# India public holidays (calendar-api):
HOLIDAYS_API_URL=https://calendar-api-d7a8.onrender.com/v1/holidays
HOLIDAYS_COUNTRY=IN
HOLIDAYS_REGION=RJ
