PORT=3334
HOST=0.0.0.0
# Docker Compose maps host 3333 → this PORT (see docker-compose.yml).
NODE_ENV=development
LOG_LEVEL=info

# India public holidays (calendar-api):
HOLIDAYS_API_URL=https://calendar-api-d7a8.onrender.com/v1/holidays
HOLIDAYS_COUNTRY=IN
HOLIDAYS_REGION=RJ

# MySQL (tables are created on first start if missing; existing tables are never altered).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=time_sheet
DB_USER=root
DB_PASSWORD=admin
DB_POOL_MAX=10
